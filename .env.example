# ============================================================================
# KITS LMS Environment Variable Template
# For production deployment with Firebase Authentication & Supabase PostgreSQL
# ============================================================================

# 1. Firebase Authentication Credentials (Web App Config)
# Obtain from Firebase Console > Project Settings > General > Your Apps > Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-kits-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-kits-project"
VITE_FIREBASE_STORAGE_BUCKET="your-kits-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# 2. Supabase PostgreSQL Database & Storage Credentials
# Obtain from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_yourPublicKeyHere"
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_yourPublicKeyHere"
SUPABASE_SECRET_KEY="sb_secret_yourSecretKeyHere"
SUPABASE_JWKS_URL="https://your-supabase-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# 3. Supabase Direct Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:yourPassword@db.your-project-id.supabase.co:5432/postgres"
PGHOST="db.your-project-id.supabase.co"
PGPORT=5432
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="yourPassword"

# 4. Supabase Storage Bucket
VITE_SUPABASE_STORAGE_BUCKET="exam-papers"

# 5. Server-Side Trusted Admin Credentials & Session Secrets
ADMIN_USERNAME="IT"
ADMIN_PASSWORD="INFORMATIONTECHNOLOGY"
SESSION_SECRET="your-production-jwt-hmac-secret-key-here"
PORT=3000
